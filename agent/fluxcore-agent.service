[Unit]
Description=FluxCore Node Agent
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/fluxcore-agent
ExecStart=/opt/fluxcore-agent/venv/bin/uvicorn agent.agent:app --host 0.0.0.0 --port 62050
Restart=always
RestartSec=3
EnvironmentFile=-/etc/fluxcore-agent/agent.env

[Install]
WantedBy=multi-user.target
